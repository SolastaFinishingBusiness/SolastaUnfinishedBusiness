  <!-- The built Info.json's version (user direction, 2026-11-02): the source Info.json holds the last release's version,
       raised only when releasing; a development build's copy gets "-dev." and the first 8 characters of the commit it
       was built from, e.g. 1.10.0-dev.649e587d. Unity Mod Manager reads only the first three dot-separated parts and
       drops their non-digits (UnityModManager.ParseVersion), so it sees 1.10.0; the commit must stay after a dot, or
       its digits would join the patch number. Written on every build, so a release build after a development build in
       the same folder doesn't keep the mark. -->
  <UsingTask TaskName="StampBuildVersionTask" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" />
      <Development ParameterType="System.Boolean" />
      <Commit ParameterType="System.String" />
      <BuildVersion ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var text = File.ReadAllText(Source);
        var key = new Regex("(\"Version\"\\s*:\\s*\")([^\"]+)(\")");
        var version = key.Match(text).Groups[2].Value;
        var commit = (Commit ?? string.Empty).Trim();

        BuildVersion = Development
            ? version + "-dev." + (commit.Length >= 8 ? commit.Substring(0, 8) : "unknown")
            : version;

        // without a destination it only works the version out (FbComputeBuildVersion, before compiling)
        if (!string.IsNullOrEmpty(Destination))
        {
            File.WriteAllText(Destination,
                key.Replace(text, m => m.Groups[1].Value + BuildVersion + m.Groups[3].Value, 1));
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- The same build version, worked out before compiling and compiled into the DLL as
       [AssemblyMetadata("FbBuildVersion", ...)]. Unity Mod Manager shows and the multiplayer version check used to
       publish only Info.json's version, which says what is installed, not which DLL the game loaded. At startup
       UpdateContext compares the two, so a game still running older code under a newer Info.json says so (user
       direction, 2026-11-10, after a player's game showed 1.14.0 and desynced until a restart). Runs before the SDK
       collects the assembly attributes; the generated AssemblyInfo is rebuilt whenever the value changes. -->
  <Target Name="FbComputeBuildVersion" BeforeTargets="GetAssemblyAttributes">
    <Exec Condition="'$(FbDevelopment)'=='true'" Command="git rev-parse HEAD" ConsoleToMSBuild="true"
          WorkingDirectory="$(MSBuildProjectDirectory)" StandardOutputImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="FbBuildCommit" />
    </Exec>
    <StampBuildVersionTask Source="$(MSBuildProjectDirectory)/Info.json"
                           Development="$(FbDevelopment.Equals('true'))" Commit="$(FbBuildCommit)">
      <Output TaskParameter="BuildVersion" PropertyName="FbBuildVersion" />
    </StampBuildVersionTask>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>FbBuildVersion</_Parameter1>
        <_Parameter2>$(FbBuildVersion)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <Target Name="StampBuildVersion" AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="FbComputeBuildVersion">
    <StampBuildVersionTask Source="$(MSBuildProjectDirectory)/Info.json" Destination="$(OutDir)Info.json"
                           Development="$(FbDevelopment.Equals('true'))" Commit="$(FbBuildCommit)" />
    <Message Importance="high" Text="Finishing Business build version: $(FbBuildVersion)" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="('$(Configuration)|$(Platform)' == 'Release|AnyCPU' Or '$(Configuration)|$(Platform)' == 'Release Install|AnyCPU')">
    <Exec Command="call ZipRelease.bat" />
  </Target>

